# =============================================================================
# Abrang — .gitattributes
# The owner works on Windows. Force LF line endings for all text files that
# run inside Linux containers or are parsed strictly — above all *.sh, because
# a CRLF in a shell script breaks it with errors like: $'\r': command not found
# =============================================================================

* text=auto

*.sh   text eol=lf
*.php  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf

# Env template is parsed by Docker/Compose — keep it LF too.
.env.example text eol=lf

# Binary assets: never touch line endings.
*.woff2 binary
*.woff  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
