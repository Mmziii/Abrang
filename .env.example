# =============================================================================
# Abrang (آبرنگ) — example environment file
#
# How to use (PowerShell, in the project folder):
#     Copy-Item .env.example .env
#
# The real .env file is NEVER committed to git (it is in .gitignore).
# The values below are safe placeholders for LOCAL development on your own PC.
# Before any public/production use, change every password below.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Address where the local site opens in your browser.
WP_URL=http://localhost:8080
# Port on your computer that forwards to WordPress (must match WP_URL).
WP_PORT=8080
# Site title shown in the header and browser tab.
WP_TITLE=آبرنگ

# --- WordPress admin account ----------------------------------------------------
# Created by scripts/setup.sh on the FIRST install only.
# You log in with these at http://localhost:8080/wp-admin
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=abrang-admin-1234
WP_ADMIN_EMAIL=admin@example.com

# --- Database (MariaDB, only reachable inside Docker) ---------------------------
MYSQL_DATABASE=abrang
MYSQL_USER=abrang
MYSQL_PASSWORD=abrang-db-password
MYSQL_ROOT_PASSWORD=abrang-root-password

# --- Development options ---------------------------------------------------------
# 1 = show PHP debug messages (recommended while developing), 0 = hide them.
WP_DEBUG=1
# 0 = tell search engines NOT to index this site (right choice for local dev).
# 1 = allow indexing (only for the real public site, in a later prompt).
WP_ALLOW_SEARCH_ENGINES=0
